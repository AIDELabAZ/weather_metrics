# No version control for data files: .dta, .csv, and .sav
# No version control for Stata project files or log files

*.dta
*.sav
*.csv
*.rar
*.stpr
*.smcl
*.pdf
*.sty
*.png
*.smcl
*.docx
*.html
*.DS_Store
*.Rhistory
*.xlsx
*.stswp
*.do.stswp
.Rproj.user
.rag_gpt_embedding_cache.json

# Python bytecode
__pycache__/
*.pyc

# Run logs
*.log

# Local Claude Code settings
.claude/

# Local LLM classifier scratch/caches (regenerated by the analysis scripts)
lit_review/analysis/.pipeline_test/
lit_review/analysis/.llm_direct_cache.json
lit_review/analysis/.llm_direct_entries.json

# R session and IDE files
.RData
.Rapp.history
.idea/

# Run logs, watchdog scripts and SLURM job output
lit_review/logs/
*.out

# Superseded intermediate files
lit_review/analysis/output/
lit_review/analysis/hpc/hpc_cache_2stage.json
lit_review/analysis/hpc/local_cache_backup_pre_hpc.json
